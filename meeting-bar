#!/usr/bin/env bash
# GigaMeeting helper. Talks to omarchy-meeting-recorder and prints one
# status line on stdout. Action names and errors from the recorder stay
# available to the caller on the combined output.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
calendar="$here/calendar.py"
recorder=omarchy-meeting-recorder
meetings="${MEETINGS_ROOT:-$HOME/Documents/Meetings}"
export MEETINGS_ROOT="$meetings"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-meeting-recorder"

one_state() {
  local line state
  line=$(timeout 1.2 "$recorder" watch 2>/dev/null | head -n 1 || true)
  if [[ $line != *'"state":"'* ]]; then
    echo off
    return
  fi
  state=${line#*'"state":"'}
  state=${state%%'"'*}
  case $state in
    off|idle|recording|paused|stopping|transcribing|done) ;;
    *) state=off ;;
  esac
  printf '%s\n' "$state"
}

has_unfinished() {
  local dir bytes name
  [[ -d $cache ]] || return 1
  shopt -s nullglob
  for dir in "$cache"/*; do
    [[ -d $dir ]] || continue
    for name in mic.raw system.raw; do
      [[ -f $dir/$name ]] || continue
      bytes=$(stat -c %s "$dir/$name" 2>/dev/null || echo 0)
      if (( bytes > 0 )); then
        return 0
      fi
    done
  done
  return 1
}

launch_recorder() {
  if command -v uwsm-app >/dev/null 2>&1; then
    setsid -f uwsm-app -- "$recorder" >/dev/null 2>&1
  else
    setsid -f "$recorder" >/dev/null 2>&1
  fi
}

cmd_start() {
  local state deadline name=${1:-}
  name=${name//$'\n'/ }
  name=${name//$'\r'/ }
  state=$(one_state)
  if [[ $state == off ]]; then
    if has_unfinished; then
      launch_recorder
      echo recovery
      return 0
    fi
    launch_recorder
    deadline=$((SECONDS + 8))
    while (( SECONDS < deadline )); do
      state=$(one_state)
      [[ $state == idle || $state == done || $state == recording || $state == paused ]] && break
      sleep 0.4
    done
  fi
  case $state in
    recording|paused)
      echo already
      ;;
    idle|done|transcribing)
      # `omarchy-meeting-recorder start "Meeting Name"`. No --name flag.
      if [[ -n $name ]]; then
        if "$recorder" start "$name" >/dev/null; then
          echo started
        else
          echo "failed: the recorder is not running"
          return 1
        fi
      elif "$recorder" start >/dev/null; then
        echo started
      else
        echo "failed: the recorder is not running"
        return 1
      fi
      ;;
    *)
      echo "failed: recorder is $state"
      return 1
      ;;
  esac
}

# gio returns as soon as the handler starts. xdg-open waits for the program,
# and a meeting app that stays open would pin the card. A handler still
# running after a few seconds counts as opened and is left in its own session.
open_detached() {
  local target=$1 pid=0 i
  if command -v gio >/dev/null 2>&1; then
    setsid gio open "$target" >/dev/null 2>&1 &
  else
    setsid xdg-open "$target" >/dev/null 2>&1 &
  fi
  pid=$!
  for ((i = 0; i < 30; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"
      return $?
    fi
    sleep 0.1
  done
  disown "$pid" 2>/dev/null || true
  return 0
}

cmd_open() {
  local url=${1:-}
  if [[ ! $url =~ ^https?:// ]]; then
    echo "failed: not a meeting link"
    return 1
  fi
  if open_detached "$url"; then
    echo opened
  else
    echo "failed: could not open the meeting link"
    return 1
  fi
}

cmd_day() {
  python3 "$calendar" day
}

cmd_agenda() {
  python3 "$calendar" agenda
}

cmd_open_event() {
  python3 "$calendar" open-event "$1"
}

cmd_prep() {
  python3 "$calendar" prep "$1"
}

cmd_open_note() {
  python3 "$calendar" open-note "$1"
}

cmd_recent() {
  python3 "$calendar" recent
}

cmd_open_recent() {
  python3 "$calendar" open-recent "$1" "$2"
}

cmd_audio() {
  python3 "$calendar" audio "$1"
}

cmd_simple() {
  if "$recorder" "$1" >/dev/null; then
    echo ok
  else
    echo "failed: the recorder is not running"
    return 1
  fi
}

cmd_actions() {
  local out
  out=$("$recorder" action 2>&1 || true)
  printf '%s\n' "$out" | awk '/^  / { sub(/^  /, ""); print }'
}

cmd_latest() {
  python3 - "$1" "$meetings" <<'PY'
import json, sys, time
from pathlib import Path

title = sys.argv[1]
root = Path(sys.argv[2])

def safe(text):
    cleaned = "".join("-" if c in '/\\:*?"<>|' else c for c in text)
    trimmed = cleaned.strip(" .")
    return trimmed or "Meeting"

def contained(path):
    try:
        resolved = path.resolve(strict=True)
        base = root.resolve(strict=True)
    except OSError:
        return None
    if resolved == base or base not in resolved.parents:
        return None
    if not (resolved / "transcript.md").is_file():
        return None
    return resolved

if not root.is_dir():
    sys.exit(0)

want = safe(title) if title else ""
dirs = []
seen = set()
for path in root.iterdir():
    if not path.is_dir():
        continue
    resolved = contained(path)
    if resolved is None or resolved in seen:
        continue
    seen.add(resolved)
    dirs.append(resolved)
dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)

def manifest_title(path):
    for manifest in path.glob("*.meeting-recorder"):
        try:
            data = json.loads(manifest.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict) and isinstance(data.get("title"), str):
            return data["title"]
    return ""

now = time.time()
for path in dirs:
    if not want:
        if now - path.stat().st_mtime < 15 * 60:
            print(path)
        break
    stored = manifest_title(path)
    name = path.name
    suffix = name[13:] if len(name) > 13 and name[12] == " " and name[:12].isdigit() else name
    if suffix == want or stored == title or safe(stored) == want:
        print(path)
        break
PY
}

cmd_run() {
  local name=$1 folder=$2 root real
  [[ -n $name && -n $folder ]] || { echo "missing meeting folder"; return 1; }
  root=$(realpath -m "$meetings")
  real=$(realpath -m "$folder")
  [[ -d $real && -f $real/transcript.md && $real == "$root"/* ]] || { echo "missing meeting folder"; return 1; }
  "$recorder" action "$name" "$real"
}

usage() {
  echo "Usage: meeting-bar start [title]|pause|stop|open <url>|day|agenda|open-event <id>|prep <id>|open-note <url>|recent|open-recent <id> <kind>|audio <id>|actions|latest [title]|run <name> <folder>" >&2
  return 2
}

case ${1:-} in
  start) cmd_start "${2:-}" ;;
  pause) cmd_simple pause ;;
  stop) cmd_simple stop ;;
  open) cmd_open "${2:-}" ;;
  day) cmd_day ;;
  agenda) cmd_agenda ;;
  open-event) cmd_open_event "${2:-}" ;;
  prep) cmd_prep "${2:-}" ;;
  open-note) cmd_open_note "${2:-}" ;;
  recent) cmd_recent ;;
  open-recent) cmd_open_recent "${2:-}" "${3:-}" ;;
  audio) cmd_audio "${2:-}" ;;
  actions) cmd_actions ;;
  latest) cmd_latest "${2:-}" ;;
  run) cmd_run "${2:-}" "${3:-}" ;;
  *) usage ;;
esac
