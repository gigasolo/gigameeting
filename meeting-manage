#!/usr/bin/env python3
"""File a Meeting Recorder recording into the Obsidian vault.

    meeting-manage both [meeting-folder] [--kind solo|meeting]
    meeting-manage file [meeting-folder]
    meeting-manage insights [meeting-folder]
    meeting-manage status
    meeting-manage sync
    meeting-manage open [meeting-folder]

The done page runs `both`: the audio link, the transcript, and a separate
insights note. Insights call Grok 4.7 at medium effort, with tools off. A
short transcript is one call. A longer one is read in parts: each part
returns short bullets, this script assembles them, and Grok writes only the
summary.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse
from dataclasses import dataclass
from pathlib import Path

VAULT = Path(os.path.expanduser(os.environ.get("OBSIDIAN_VAULT", "~/Documents/Obsidian")))
FOLDER = os.environ.get("OBSIDIAN_FOLDER", "Meetings")
MEETINGS_ROOT = Path(os.path.expanduser(os.environ.get("MEETINGS_ROOT", "~/Documents/Meetings")))
SIDECAR = ".obsidian-filed.json"
UNNAMED = re.compile(r"^(You|Remote|Room|Speaker)( \d+)?$")
COMPANIES = ("VirtualPBX", "GigaSolo", "Poniq")
ILLEGAL = re.compile(r'[\\/:*?"<>|]')
MY_NOTES = "## My notes"
INSIGHT_HEADINGS = (
    "## Summary",
    "## Insights",
    "## Ideas",
    "## Novel items",
    "## Actions",
    "## Open questions",
)
# Grok is given the prompt as one argument. Linux refuses an argument past
# 128 KB, and the recorder stops at 120 KB, so each piece of transcript stays
# well under that. One piece is one full ask. A longer transcript is bullets
# per piece, assembled here, then one summary ask. The recorder kills an ask
# at 300 seconds, which used to drop the merge of several full notes.
CHUNK_BYTES = 32_000
ASK_TIMEOUT = 330
# The recorder kills an ask at 300s. Meeting asks use the same bound, on
# grok-4.7 at medium effort. That does not change the model used in a normal
# Grok session.
GROK_MODEL = "grok-4.7"
GROK_EFFORT = "medium"
GROK_ASK_SECONDS = 300
NONE_NOTED = "None noted."
TURN_CLOCK = re.compile(r"^\*\*\[(\d{1,2}:\d{2}(?::\d{2})?)\] ")

MEETING_PROMPT = """Extract notes from this meeting transcript. Write in the language of the meeting.
Markdown only, no preamble. The recording may be short. Still use every heading.

Use exactly these headings, in this order, and no others:
## Summary
## Insights
## Ideas
## Novel items
## Actions
## Open questions

Rules:
- Use only what was said. Do not invent facts, people, owners, or deadlines.
- Summary: a few sentences on what the meeting was about.
- Insights: conclusions, tensions, or observations that were actually reached.
- Ideas: proposals or possibilities someone raised.
- Novel items: things that are new, surprising, or specifically interesting. If nothing qualifies, write "None noted."
- Actions: bullets of who does what. If the owner was not named, start the bullet with "unassigned:". If there are no actions, write "None noted."
- Open questions: questions left unresolved. If none, write "None noted."
- Do not copy the transcript. A short quote is fine when it carries the point.
"""

SOLO_PROMPT = """This recording is one person thinking aloud. It is not a meeting with other attendees.
Do not invent other people, and do not assign work to anyone else.
Write in the language of the recording. Markdown only, no preamble.
The recording may be short. Still use every heading.

Use exactly these headings, in this order, and no others:
## Summary
## Insights
## Ideas
## Novel items
## Actions
## Open questions

Rules:
- Use only what was said. Do not invent facts.
- Summary: a few sentences.
- Insights: observations worth keeping.
- Ideas: ideas they surfaced.
- Novel items: new or specifically interesting points. If nothing qualifies, write "None noted."
- Actions: commitments they made to themselves. If none, write "None noted."
- Open questions: questions to revisit. If none, write "None noted."
- Do not copy the transcript.
"""


@dataclass
class Meeting:
    folder: Path
    title: str
    date: str
    started_at: int
    duration_secs: int
    speakers: list[str]
    chapters: list[dict]
    transcript_path: Path
    transcript_text: str
    audio: Path | None


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def clock(ms: int) -> str:
    seconds = ms // 1000
    if seconds >= 3600:
        return f"{seconds // 3600}:{seconds // 60 % 60:02}:{seconds % 60:02}"
    return f"{seconds // 60:02}:{seconds % 60:02}"


def duration_label(seconds: int) -> str:
    if seconds >= 90:
        return f"{round(seconds / 60)} minutes"
    return f"{seconds} seconds"


def note_name(date: str, title: str) -> str:
    return ILLEGAL.sub("-", f"{date[:10]} {title}").strip()


def people_of(speakers: list[str]) -> list[str]:
    return [speaker for speaker in speakers if speaker and not UNNAMED.match(speaker)]


def company_of(title: str) -> str | None:
    for name in COMPANIES:
        if name in title:
            return name
    return None


def yaml_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def obsidian_link(rel_without_suffix: str) -> str:
    query = urllib.parse.urlencode(
        {"vault": VAULT.name, "file": rel_without_suffix},
        quote_via=urllib.parse.quote,
    )
    return "obsidian://open?" + query


def find_audio(folder: Path) -> Path | None:
    preferred = folder / "audio.ogg"
    if preferred.exists():
        return preferred
    audio = [
        path
        for path in folder.iterdir()
        if path.is_file() and path.suffix.lower() in {".ogg", ".opus", ".mp3", ".wav", ".m4a"}
    ]
    return audio[0] if audio else None


def find_manifest(folder: Path) -> tuple[Path | None, dict]:
    found = sorted(folder.glob("*.meeting-recorder"))
    if not found:
        return None, {}
    try:
        return found[0], json.loads(found[0].read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"Could not read {found[0].name}: {exc}")


def date_from_transcript(text: str, started_at: int) -> str:
    match = re.search(r"\*\*Date:\*\*\s*(\d{4}-\d{2}-\d{2} \d{2}:\d{2})", text)
    if match:
        return match.group(1)
    if started_at:
        return time.strftime("%Y-%m-%d %H:%M", time.localtime(started_at))
    return time.strftime("%Y-%m-%d %H:%M")


def load_meeting(folder: Path) -> Meeting:
    folder = folder.expanduser().resolve()
    if not folder.is_dir():
        fail(f"No meeting folder at {folder}")
    manifest_path, manifest = find_manifest(folder)
    transcript_path = Path(os.environ["MEETING_TRANSCRIPT"]) if (
        os.environ.get("MEETING_DIR")
        and Path(os.environ["MEETING_DIR"]).expanduser().resolve() == folder
        and os.environ.get("MEETING_TRANSCRIPT")
    ) else folder / "transcript.md"
    if not transcript_path.is_file():
        fail(f"No transcript yet in {folder.name}")
    text = transcript_path.read_text(encoding="utf-8")
    env_here = os.environ.get("MEETING_DIR") and Path(os.environ["MEETING_DIR"]).expanduser().resolve() == folder
    speakers = []
    if env_here and os.environ.get("MEETING_SPEAKERS"):
        speakers = [line for line in os.environ["MEETING_SPEAKERS"].splitlines() if line.strip()]
    if not speakers:
        speakers = list(manifest.get("speakers") or manifest.get("labels") or [])
    started = 0
    if env_here and os.environ.get("MEETING_STARTED_AT"):
        started = int(os.environ["MEETING_STARTED_AT"])
    elif manifest.get("started_at"):
        started = int(manifest["started_at"])
    if not started:
        fail(f"No start time for {folder.name}")
    seconds = 0
    if env_here and os.environ.get("MEETING_DURATION"):
        seconds = int(os.environ["MEETING_DURATION"])
    elif manifest.get("duration_secs") is not None:
        seconds = int(manifest["duration_secs"])
    title = (os.environ.get("MEETING_TITLE") if env_here else None) or manifest.get("title") or folder.name
    date = (os.environ.get("MEETING_DATE") if env_here else None) or date_from_transcript(text, started)
    audio_env = os.environ.get("MEETING_AUDIO") if env_here else None
    audio = Path(audio_env) if audio_env and Path(audio_env).exists() else find_audio(folder)
    return Meeting(
        folder=folder,
        title=title,
        date=date,
        started_at=started,
        duration_secs=seconds,
        speakers=speakers,
        chapters=list(manifest.get("chapters") or []),
        transcript_path=transcript_path,
        transcript_text=text,
        audio=audio,
    )


def resolve_folder(arg: str | None) -> Path:
    if arg:
        return Path(arg).expanduser().resolve()
    if os.environ.get("MEETING_DIR"):
        return Path(os.environ["MEETING_DIR"]).expanduser().resolve()
    cwd = Path.cwd()
    if (cwd / "transcript.md").is_file() or any(cwd.glob("*.meeting-recorder")):
        return cwd
    fail("No meeting folder. Pass one, or run this from a recording.")


def read_sidecar(folder: Path) -> dict:
    path = folder / SIDECAR
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


def write_sidecar(folder: Path, data: dict) -> None:
    (folder / SIDECAR).write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def kind_for(meeting: Meeting, sidecar: dict, requested: str | None) -> tuple[str, str | None]:
    override = requested or sidecar.get("kind_override")
    if override in ("solo", "meeting"):
        return override, override if requested or sidecar.get("kind_override") else None
    kind = "solo" if len(meeting.speakers) < 2 else "meeting"
    return kind, None


def destination(kind: str, date: str, title: str) -> tuple[Path, Path, str, str]:
    stem = note_name(date, title)
    base = VAULT / FOLDER / ("Solo" if kind == "solo" else "")
    transcript = base / f"{stem}.md"
    insights = base / f"{stem} — Insights.md"
    rel_root = f"{FOLDER}/Solo" if kind == "solo" else FOLDER
    return transcript, insights, f"{rel_root}/{stem}", f"{rel_root}/{stem} — Insights"


def transcript_body(text: str) -> str:
    if "## Transcript" in text:
        return text.split("## Transcript", 1)[1].strip()
    return text.strip()


def my_notes_from(path: Path) -> str:
    if not path.is_file():
        return f"{MY_NOTES}\n\n"
    text = path.read_text(encoding="utf-8")
    index = text.find(MY_NOTES)
    if index == -1:
        return f"{MY_NOTES}\n\n"
    return text[index:].rstrip() + "\n"


def link_audio(meeting: Meeting) -> str | None:
    if meeting.audio is None or not meeting.audio.exists():
        return None
    directory = VAULT / FOLDER / "audio"
    directory.mkdir(parents=True, exist_ok=True)
    link = directory / f"{meeting.started_at}{meeting.audio.suffix.lower()}"
    target = meeting.audio.resolve()
    if link.is_symlink() or link.exists():
        if link.is_symlink() and link.resolve() == target:
            return str(link.relative_to(VAULT))
        link.unlink()
    link.symlink_to(target)
    return str(link.relative_to(VAULT))


def frontmatter(lines: list[str]) -> str:
    return "---\n" + "\n".join(lines) + "\n---\n"


def clock_label(started_at: int) -> str:
    return time.strftime("Meeting %H:%M", time.localtime(started_at))


def notes_for(started_at: int, note_type: str) -> list[Path]:
    """Notes in the vault whose frontmatter records this recording."""
    root = VAULT / FOLDER
    if not root.is_dir():
        return []
    needle_id = f"started_at: {started_at}"
    needle_type = f"type: {note_type}"
    found = []
    for path in root.rglob("*.md"):
        if path.name == "Index.md" or not path.is_file():
            continue
        head = path.read_text(encoding="utf-8")[:1200]
        if needle_id in head and needle_type in head:
            found.append(path)
    return found


def note_with_started_at(started_at: int, note_type: str) -> Path | None:
    found = notes_for(started_at, note_type)
    return found[0] if found else None


def link_of(path: Path) -> str:
    return str(path.relative_to(VAULT).with_suffix(""))


def owned_stem(meeting: Meeting, sidecar: dict) -> str | None:
    title = sidecar.get("title")
    if not isinstance(title, str) or not title:
        return None
    date = str(sidecar.get("date") or meeting.date)
    return note_name(date, title)


def note_stem(path: Path) -> str:
    stem = path.stem
    suffix = " — Insights"
    if stem.endswith(suffix):
        return stem[: -len(suffix)]
    return stem


def keep_existing_name(existing: Path, desired: Path, meeting: Meeting, sidecar: dict) -> bool:
    """A hand-renamed note stays where it is.

    The clock name, and the name this script last wrote, follow a new title.
    """
    if existing.resolve() == desired.resolve():
        return True
    stem = note_stem(existing)
    if stem == note_stem(desired):
        return False
    previous = owned_stem(meeting, sidecar)
    if previous and stem == previous and sidecar.get("title") != meeting.title:
        return False
    clock = note_name(meeting.date, clock_label(meeting.started_at))
    if stem == clock and meeting.title != clock_label(meeting.started_at):
        return False
    return True


def settle_note(existing: Path | None, desired: Path, meeting: Meeting, sidecar: dict) -> Path:
    desired.parent.mkdir(parents=True, exist_ok=True)
    if existing is None or not existing.is_file():
        return desired
    if keep_existing_name(existing, desired, meeting, sidecar):
        return existing
    if desired.exists() and desired.resolve() != existing.resolve():
        return desired
    existing.rename(desired)
    return desired


def adopt_note(meeting: Meeting, sidecar: dict, kind: str, note_type: str, rel_key: str, insights: bool) -> Path:
    transcript_path, insights_path, _, _ = destination(kind, meeting.date, meeting.title)
    desired = insights_path if insights else transcript_path
    existing = None
    rel = sidecar.get(rel_key)
    if isinstance(rel, str) and rel:
        candidate = VAULT / rel
        if candidate.is_file():
            existing = candidate
    if existing is None:
        existing = note_with_started_at(meeting.started_at, note_type)
    return settle_note(existing, desired, meeting, sidecar)


def retire_stale_insights(keep: Path, meeting: Meeting, sidecar: dict) -> None:
    """Drop a clock-named or previously written insights note once the current one exists."""
    clock = note_name(meeting.date, clock_label(meeting.started_at))
    previous = owned_stem(meeting, sidecar)
    for path in notes_for(meeting.started_at, "meeting-insights"):
        if not path.is_file() or path.resolve() == keep.resolve():
            continue
        stem = note_stem(path)
        stale_clock = stem == clock and meeting.title != clock_label(meeting.started_at)
        stale_owned = bool(previous) and stem == previous and sidecar.get("title") != meeting.title
        if not stale_clock and not stale_owned:
            continue
        extra = my_notes_from(path).replace(MY_NOTES, "", 1).strip()
        if extra and keep.is_file():
            text = keep.read_text(encoding="utf-8")
            if extra not in text:
                if MY_NOTES in text:
                    text = text.rstrip() + "\n\n" + extra + "\n"
                else:
                    text = text.rstrip() + "\n\n" + MY_NOTES + "\n\n" + extra + "\n"
                keep.write_text(text, encoding="utf-8")
        path.unlink()


def write_transcript(meeting: Meeting, sidecar: dict, kind: str) -> tuple[str, dict]:
    transcript_path = adopt_note(meeting, sidecar, kind, "meeting", "transcript_rel", False)
    insights_path = adopt_note(meeting, sidecar, kind, "meeting-insights", "insights_rel", True)
    retire_stale_insights(insights_path, meeting, sidecar)
    transcript_rel = link_of(transcript_path)
    insights_rel = link_of(insights_path)
    people = people_of(meeting.speakers)
    company = company_of(meeting.title)
    audio_rel = link_audio(meeting)
    meta = [
        f"date: {meeting.date[:10]}",
        "type: meeting",
        f"kind: {kind}",
        "source: meeting-recorder",
        f"started_at: {meeting.started_at}",
        f"duration: {yaml_quote(duration_label(meeting.duration_secs))}",
    ]
    if company:
        meta.append(f"company: {company}")
    if people:
        meta.append("people:")
        meta.extend(f"  - {yaml_quote('[[' + person + ']]')}" for person in people)
    tags = ["meeting"]
    if kind == "solo":
        tags.append("solo")
    meta.append("tags:")
    meta.extend(f"  - {tag}" for tag in tags)
    body = [
        f"# {meeting.title}",
        "",
        f"**Date:** {meeting.date}",
        f"**Duration:** {duration_label(meeting.duration_secs)}",
        f"**Kind:** {kind}",
    ]
    if people:
        body.append("**People:** " + ", ".join(f"[[{person}]]" for person in people))
    if company:
        body.append(f"**Company:** {company}")
    body.append(f"**Recording:** [{meeting.folder.name}]({meeting.folder.as_uri()})")
    body.append(f"**Insights:** [[{insights_rel}]]")
    if audio_rel:
        body.extend(["", f"![[{audio_rel}]]"])
    if meeting.chapters:
        body.extend(["", "## Chapters", ""])
        body.extend(
            f"- [{clock(int(chapter.get('start_ms', 0)))}] {chapter.get('title', '')}"
            for chapter in meeting.chapters
        )
    body.extend(["", "## Transcript", "", transcript_body(meeting.transcript_text), ""])
    transcript_path.write_text(frontmatter(meta) + "\n" + "\n".join(body), encoding="utf-8")
    updated = {
        "started_at": meeting.started_at,
        "date": meeting.date,
        "title": meeting.title,
        "kind": kind,
        "kind_override": sidecar.get("kind_override"),
        "duration": duration_label(meeting.duration_secs),
        "people": people,
        "company": company,
        "transcript_rel": str(transcript_path.relative_to(VAULT)),
        "insights_rel": str(insights_path.relative_to(VAULT)),
        "audio_rel": audio_rel,
        "meeting_dir": str(meeting.folder),
    }
    return transcript_rel, updated


def clean_answer(text: str) -> str:
    stripped = text.strip()
    if stripped.startswith("```"):
        stripped = re.sub(r"^```[a-zA-Z]*\n", "", stripped)
        stripped = re.sub(r"\n```$", "", stripped).strip()
    match = re.search(r"^## ", stripped, re.M)
    if match:
        stripped = stripped[match.start() :]
    return stripped.strip()


def split_text(text: str, limit: int) -> list[str]:
    """Split on speaker turns so each piece stays under `limit` bytes."""
    if len(text.encode()) <= limit:
        return [text]
    parts: list[str] = []
    current: list[str] = []
    size = 0
    for block in text.split("\n\n"):
        encoded = len(block.encode()) + 2
        if current and size + encoded > limit:
            parts.append("\n\n".join(current))
            current = []
            size = 0
        if encoded > limit:
            if current:
                parts.append("\n\n".join(current))
                current = []
                size = 0
            start = 0
            raw = block
            while start < len(raw):
                piece = raw[start : start + limit]
                # Keep the cut on a character boundary already guaranteed by slicing str.
                parts.append(piece)
                start += limit
            continue
        current.append(block)
        size += encoded
    if current:
        parts.append("\n\n".join(current))
    return parts


